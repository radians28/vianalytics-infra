# ---- Public domain ----
# DNS A record of DOMAIN must point at the VPS before first start (for TLS)
DOMAIN=app.your-domain.com
ACME_EMAIL=admin@your-domain.com
# Local only: "local_certs" makes Caddy use its own CA instead of Let's Encrypt
# (for a DOMAIN pointed at 127.0.0.1 in /etc/hosts). Leave empty in production.
CADDY_GLOBAL_OPTIONS=

# ---- Database ----
# Choose ONE mode:
#
# A) New database (default): compose starts its own Postgres ("db" service, local-db profile),
#    bound to 127.0.0.1 on the VPS; connect through an SSH tunnel:
#      ssh -N -L 5432:127.0.0.1:5432 user@app.your-domain.com
#
# B) Existing Postgres: compose does NOT start "db"; set COMPOSE_PROFILES empty and point
#    DB_HOST / DB_PORT at the existing server. POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#    are then the credentials and database on that server (must already exist).
#    B1) Postgres in another container on the same Docker host (recommended):
#          docker network create vianalytics_dbnet
#          docker network connect vianalytics_dbnet my-postgres
#        DB_HOST=my-postgres  DB_PORT=5432  DB_NETWORK=vianalytics_dbnet  DB_NETWORK_EXTERNAL=true
#    B2) Postgres published on the Docker host's port (e.g. -p 5432:5432):
#        DB_HOST=host.docker.internal  DB_PORT=5432  (no network settings)
#    B3) Postgres on another machine: DB_HOST=<hostname or IP>  DB_PORT=5432
#
# The user needs CREATEDB once so airflow-init can create AIRFLOW_DB_NAME; otherwise create
# that database on the server beforehand (CREATE DATABASE airflow OWNER <POSTGRES_USER>;).

# A) new database
COMPOSE_PROFILES=local-db
DB_HOST=db
DB_PORT=5432
# B1) existing Postgres container (uncomment, and comment out the block above)
# COMPOSE_PROFILES=
# DB_HOST=my-postgres
# DB_PORT=5432
# DB_NETWORK=vianalytics_dbnet
# DB_NETWORK_EXTERNAL=true

POSTGRES_USER=vianalytics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vianalytics
# Database for Airflow metadata, created on the same server by airflow-init if missing
AIRFLOW_DB_NAME=airflow
# Mode A only: loopback port the local db is published on
DB_TUNNEL_PORT=5432

# ---- API (vianalytics-svc) ----
# Gunicorn worker processes per API container (scale containers with --scale api=N)
GUNICORN_WORKERS=2
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
# Initial admin account, seeded after migrations (skipped if empty or the email exists)
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=change-me

# ---- Airflow (scheduled jobs, https://DOMAIN/airflow) ----
AIRFLOW_VERSION=3.3.2
# Linux: set to your user id ($(id -u)) so ./airflow/logs is writable
AIRFLOW_UID=50000
# Encrypts stored connections/variables. Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
# Signs web sessions and internal API tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_SECRET_KEY=change-me
# Web UI login, created on first start
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# ---- UI (vianalytics-ui) ----
# API base URL baked into the static bundle at build time (rebuild ui after changing)
VITE_API_BASE_URL=/api
